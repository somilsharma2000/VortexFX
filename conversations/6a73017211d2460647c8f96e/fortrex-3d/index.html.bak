<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FORTREX — Your Edge. Your Arena. Your Legacy.</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #000000;
  --cyan: #00F2FE;
  --cyan-dim: #00B4FF;
  --blue: #3B82F6;
  --indigo: #6366F1;
  --emerald: #10B981;
  --text: #FFFFFF;
  --slate: #94A3B8;
  --slate-dim: #64748B;
  --slate-faint: #475569;
}

* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  background: var(--bg);
  color: var(--text);
  font-family: 'Inter', sans-serif;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

#three-canvas {
  position: fixed; top: 0; left: 0;
  width: 100%; height: 100%; z-index: 0; pointer-events: none;
  opacity: 0;
  transition: opacity 1s ease;
}
.content { position: relative; z-index: 1; }

.mono { font-family: 'JetBrains Mono', monospace; }
.gradient-text {
  background: linear-gradient(90deg, var(--cyan), var(--cyan-dim), var(--blue));
  -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
}
@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
@keyframes pulse-glow {
  0%, 100% { box-shadow: 0 0 8px var(--cyan); opacity: 1; }
  50% { box-shadow: 0 0 16px var(--cyan); opacity: 0.7; }
}

/* ===== NAV ===== */
.nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  display: flex; justify-content: space-between; align-items: center;
  padding: 20px 40px; background: transparent;
}
.nav-brand { display: flex; align-items: center; gap: 12px; cursor: pointer; }
.nav-logo {
  width: 32px; height: 32px; border-radius: 6px; object-fit: cover;
  filter: drop-shadow(0 0 10px rgba(0,242,254,0.15));
}
.nav-text {
  font-family: 'JetBrains Mono', monospace;
  font-size: 18px; font-weight: 700; color: #FFF;
  letter-spacing: 4px; text-transform: uppercase;
}
.nav-prelaunch {
  padding: 3px 10px; border-radius: 100px;
  background: rgba(0,242,254,0.08); border: 1px solid rgba(0,242,254,0.2);
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px; font-weight: 600; letter-spacing: 1px;
  color: var(--cyan); text-transform: uppercase;
}
.nav-links { display: flex; gap: 32px; align-items: center; }
.nav-links a {
  color: var(--slate); text-decoration: none;
  font-size: 14px; font-weight: 500; transition: color 0.2s;
}
.nav-links a:hover { color: var(--cyan); }
.nav-actions { display: flex; align-items: center; gap: 24px; }
.nav-signin { font-size: 14px; font-weight: 600; color: var(--slate); text-decoration: none; transition: color 0.3s; }
.nav-signin:hover { color: #FFF; }
.nav-cta {
  padding: 10px 24px;
  background: #FFF; color: #000; border: none;
  border-radius: 100px; font-size: 14px; font-weight: 700;
  cursor: pointer; transition: all 0.3s; letter-spacing: -0.3px;
}
.nav-cta:hover { background: var(--cyan); transform: scale(1.05); }

/* ===== HERO ===== */
.hero {
  position: relative; min-height: 100vh;
  display: flex; flex-direction: column;
  justify-content: space-between; overflow: hidden;
}
.hero-video {
  position: absolute; inset: 0; z-index: 0; overflow: hidden;
}
.hero-video video {
  width: 100%; height: 100%; object-fit: cover;
  transform: scale(1.5); transform-origin: top left;
  opacity: 0.25; filter: grayscale(1) contrast(1.25);
}
.hero-overlay-v {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.5) 50%, #000 100%);
}
.hero-overlay-h {
  position: absolute; inset: 0;
  background: linear-gradient(90deg, rgba(0,0,0,0.6), transparent, rgba(0,0,0,0.6));
}
.hero-glow {
  position: absolute; top: 33%; left: 50%;
  transform: translate(-50%, -50%);
  width: 600px; height: 400px;
  background: rgba(0,242,254,0.06);
  filter: blur(140px); border-radius: 50%;
  pointer-events: none;
}

.hero-content {
  position: relative; z-index: 10; flex: 1;
  display: flex; flex-direction: column;
  justify-content: center; align-items: center;
  text-align: center; padding: 100px 20px 30px;
  max-width: 800px; margin: 0 auto;
}

.hero-pill {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 6px 16px; border-radius: 100px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.08);
  backdrop-filter: blur(12px); margin-bottom: 36px;
}
.hero-pill .dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--cyan); animation: pulse-glow 2s infinite;
}
.hero-pill span:last-child {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px; letter-spacing: 2px;
  text-transform: uppercase; color: var(--cyan); font-weight: 500;
}

.hero h1 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: clamp(40px, 7vw, 84px);
  font-weight: 800; letter-spacing: -2px;
  line-height: 0.95; text-transform: uppercase;
  margin-bottom: 28px; color: #FFF;
}

.hero-sub {
  font-size: clamp(15px, 2.2vw, 20px);
  font-weight: 300; color: #CBD5E1;
  max-width: 560px; line-height: 1.65; margin-bottom: 36px;
}

.btn-pill-primary {
  padding: 16px 40px;
  background: #FFF; color: #000;
  border: none; border-radius: 100px;
  font-size: 16px; font-weight: 700; letter-spacing: -0.3px;
  cursor: pointer; transition: all 0.3s;
  box-shadow: 0 4px 30px rgba(0,242,254,0.08);
}
.btn-pill-primary:hover {
  background: var(--cyan); transform: scale(1.05);
  box-shadow: 0 8px 35px rgba(0,242,254,0.2);
}

/* Waitlist */
.waitlist { width: 100%; max-width: 440px; margin-top: 44px; }
.waitlist-input-wrap {
  display: flex; align-items: center; gap: 8px;
  padding: 8px; border-radius: 100px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.08);
  backdrop-filter: blur(12px); transition: border-color 0.3s;
}
.waitlist-input-wrap:focus-within { border-color: rgba(0,242,254,0.2); }
.waitlist-input {
  flex: 1; background: transparent; border: none; outline: none;
  color: #FFF; font-size: 14px; font-weight: 500;
  padding: 8px 16px; font-family: 'Inter', sans-serif;
}
.waitlist-input::placeholder { color: #64748B; }
.waitlist-btn {
  padding: 10px 20px; border-radius: 100px;
  background: var(--cyan); color: #000; border: none;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px; font-weight: 700; letter-spacing: 1px;
  text-transform: uppercase; cursor: pointer;
  transition: background 0.3s; white-space: nowrap;
}
.waitlist-btn:hover { background: var(--cyan-dim); }
.waitlist-claimed {
  display: flex; align-items: center; justify-content: center; gap: 8px;
  padding: 12px; border-radius: 100px;
  background: rgba(0,242,254,0.08); border: 1px solid rgba(0,242,254,0.2);
}
.waitlist-claimed span {
  font-family: 'JetBrains Mono', monospace;
  font-size: 13px; color: var(--cyan); letter-spacing: 0.5px;
}

/* Progress bar */
.scarcity { margin-top: 24px; }
.scarcity-header {
  display: flex; justify-content: space-between; margin-bottom: 8px;
}
.scarcity-label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px; letter-spacing: 1px;
  text-transform: uppercase; color: var(--slate-dim);
}
.scarcity-value {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px; letter-spacing: 1px;
  color: var(--cyan); font-weight: 600;
}
.scarcity-bar {
  height: 6px; width: 100%;
  background: rgba(255,255,255,0.04); border-radius: 100px;
  overflow: hidden; border: 1px solid rgba(255,255,255,0.04);
}
.scarcity-fill {
  height: 100%; border-radius: 100px;
  background: linear-gradient(90deg, var(--cyan), var(--blue));
  box-shadow: 0 0 12px rgba(0,242,254,0.25);
  transition: width 1.5s ease;
}

/* Hero trust strip */
.hero-strip {
  position: relative; z-index: 10; width: 100%;
  border-top: 1px solid rgba(255,255,255,0.04);
  background: rgba(0,0,0,0.4);
  backdrop-filter: blur(12px);
  padding: 16px 40px;
}
.hero-strip-inner {
  max-width: 900px; margin: 0 auto;
  display: flex; flex-wrap: wrap;
  justify-content: space-around; align-items: center; gap: 16px;
}
.hero-strip-item {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px; color: var(--slate-dim);
  letter-spacing: 1px; text-transform: uppercase;
  display: flex; align-items: center; gap: 6px;
}
.hero-strip-item .check { color: var(--cyan); }

/* ===== SECTIONS ===== */
.section {
  min-height: 100vh; padding: 120px 40px;
  display: flex; flex-direction: column; justify-content: center;
  max-width: 1100px; margin: 0 auto;
}
.section-tag {
  display: inline-flex; align-items: center; align-self: flex-start;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px; letter-spacing: 2px; text-transform: uppercase;
  color: var(--cyan); margin-bottom: 16px; font-weight: 500;
  padding: 5px 12px; border: 1px solid rgba(0,242,254,0.1);
  border-radius: 4px; background: rgba(0,242,254,0.02);
}
.section-title {
  font-family: 'Space Grotesk', sans-serif;
  font-size: clamp(30px, 5vw, 56px);
  font-weight: 700; margin-bottom: 14px; line-height: 1.1;
  color: #FFF; letter-spacing: -0.5px;
}
.section-sub {
  font-size: 16px; color: var(--slate); margin-bottom: 48px;
  max-width: 560px; line-height: 1.65; font-weight: 300;
}

.glass {
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.06);
  backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
}
.glass-hover { transition: all 0.4s cubic-bezier(0.23,1,0.32,1); }
.glass-hover:hover {
  border-color: rgba(0,242,254,0.15);
  background: rgba(255,255,255,0.04);
  transform: translateY(-4px);
  box-shadow: 0 12px 40px rgba(0,0,0,0.3);
}

/* Arena cards */
.arena-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; }
.arena-card { border-radius: 16px; padding: 28px; position: relative; overflow: hidden; }
.arena-card::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, transparent, var(--cyan), transparent);
  opacity: 0; transition: opacity 0.5s;
}
.arena-card:hover::before { opacity: 1; }
.arena-status {
  display: inline-flex; align-items: center; gap: 6px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px; font-weight: 500; margin-bottom: 16px;
  letter-spacing: 1px; text-transform: uppercase;
}
.arena-status .dot { width: 6px; height: 6px; border-radius: 50%; }
.arena-status.live { color: var(--emerald); }
.arena-status.live .dot { background: var(--emerald); box-shadow: 0 0 6px var(--emerald); animation: blink 1.5s infinite; }
.arena-status.soon { color: var(--cyan); }
.arena-status.soon .dot { background: var(--cyan); box-shadow: 0 0 6px var(--cyan); }
.arena-status.locked { color: var(--slate-faint); }
.arena-status.locked .dot { background: var(--slate-faint); }
.arena-name { font-family: 'Space Grotesk', sans-serif; font-size: 20px; font-weight: 600; margin-bottom: 10px; color: #FFF; }
.arena-desc { font-size: 13px; color: var(--slate); margin-bottom: 20px; line-height: 1.6; font-weight: 300; }
.arena-prize { display: flex; justify-content: space-between; align-items: center; padding-top: 16px; border-top: 1px solid rgba(255,255,255,0.04); }
.arena-prize-label { font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--slate-faint); text-transform: uppercase; letter-spacing: 1px; }
.arena-prize-value { font-family: 'Space Grotesk', sans-serif; font-size: 16px; font-weight: 600; color: var(--cyan); }
.arena-progress { margin-top: 16px; }
.progress-bar { height: 3px; background: rgba(255,255,255,0.04); border-radius: 2px; overflow: hidden; }
.progress-fill { height: 100%; background: linear-gradient(90deg, var(--cyan), var(--blue)); border-radius: 2px; box-shadow: 0 0 6px rgba(0,242,254,0.15); }
.progress-label { font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--slate-faint); margin-top: 8px; display: flex; justify-content: space-between; }

/* Steps */
.steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
.step { text-align: center; padding: 40px 28px; border-radius: 16px; position: relative; overflow: hidden; }
.step::before { content: ''; position: absolute; top: 0; left: 50%; width: 40%; height: 1px; transform: translateX(-50%); background: linear-gradient(90deg, transparent, var(--cyan), transparent); opacity: 0.2; }
.step-num { font-family: 'Space Grotesk', sans-serif; font-size: 48px; font-weight: 700; color: var(--cyan); opacity: 0.12; margin-bottom: 8px; line-height: 1; }
.step h3 { font-family: 'Space Grotesk', sans-serif; font-size: 17px; font-weight: 600; margin-bottom: 12px; color: #FFF; }
.step p { font-size: 13px; color: var(--slate); line-height: 1.6; font-weight: 300; }

/* Rebate stat cards */
.rebate-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; }
.rebate-card { border-radius: 16px; padding: 28px; text-align: center; }
.rebate-card .label { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--slate-faint); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 12px; }
.rebate-card .value { font-family: 'Space Grotesk', sans-serif; font-size: 36px; font-weight: 700; color: #FFF; }
.rebate-card .value.cyan { color: var(--cyan); }
.rebate-card .note { font-size: 12px; color: var(--slate); margin-top: 8px; font-weight: 300; }

/* Rex */
.rex-section { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
.rex-holo { border-radius: 20px; padding: 44px 32px; text-align: center; position: relative; overflow: hidden; background: linear-gradient(135deg, rgba(0,242,254,0.04), rgba(99,102,241,0.04)); border: 1px solid rgba(0,242,254,0.1); }
.rex-holo::before { content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: conic-gradient(from 0deg, transparent, rgba(0,242,254,0.02), transparent, rgba(99,102,241,0.02), transparent); animation: rotate-bg 8s linear infinite; pointer-events: none; }
@keyframes rotate-bg { to { transform: rotate(360deg); } }
.rex-symbol { font-family: 'Space Grotesk', sans-serif; font-size: 52px; font-weight: 700; margin-bottom: 8px; position: relative; }
.rex-label { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: var(--slate); margin-bottom: 24px; position: relative; }
.rex-balance { font-family: 'Space Grotesk', sans-serif; font-size: 40px; font-weight: 700; color: #FFF; position: relative; }
.rex-balance-label { font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--slate-faint); margin-top: 6px; position: relative; letter-spacing: 1px; }
.rex-note { font-size: 12px; color: var(--slate-faint); margin-top: 24px; line-height: 1.6; position: relative; font-weight: 300; }
.rex-earn h4, .rex-spend h4 { font-family: 'JetBrains Mono', monospace; font-size: 11px; margin-bottom: 12px; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 600; }
.rex-earn h4 { color: var(--emerald); }
.rex-spend h4 { color: var(--indigo); }
.rex-list { list-style: none; }
.rex-list li { padding: 12px 0; font-size: 13px; color: var(--slate); border-bottom: 1px solid rgba(255,255,255,0.03); display: flex; justify-content: space-between; align-items: center; font-weight: 300; }
.rex-list li span:last-child { font-family: 'Space Grotesk', sans-serif; color: var(--cyan); font-weight: 600; }

/* Leaderboard */
.leaderboard { border-radius: 16px; overflow: hidden; }
.lb-header, .lb-row { display: grid; grid-template-columns: 50px 1fr 100px 90px 80px; padding: 14px 24px; align-items: center; }
.lb-header { font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--slate-faint); text-transform: uppercase; letter-spacing: 1px; border-bottom: 1px solid rgba(255,255,255,0.04); font-weight: 500; }
.lb-row { border-bottom: 1px solid rgba(255,255,255,0.02); transition: background 0.3s; }
.lb-row:hover { background: rgba(0,242,254,0.02); }
.lb-row:last-child { border-bottom: none; }
.lb-rank { font-family: 'Space Grotesk', sans-serif; font-size: 16px; font-weight: 700; }
.lb-rank.gold { color: var(--cyan); }
.lb-rank.silver { color: #CBD5E1; }
.lb-rank.bronze { color: #B45309; }
.lb-name { font-weight: 500; font-size: 14px; color: #FFF; }
.lb-bracket { font-size: 12px; color: var(--slate); }
.lb-score { font-family: 'Space Grotesk', sans-serif; font-size: 14px; font-weight: 600; color: var(--emerald); }
.lb-rex { font-family: 'Space Grotesk', sans-serif; font-size: 13px; color: var(--indigo); font-weight: 600; }

/* Calculator */
.calc-card { border-radius: 16px; padding: 36px; max-width: 520px; }
.calc-row { margin-bottom: 24px; }
.calc-label { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--slate); margin-bottom: 8px; display: block; letter-spacing: 0.5px; }
.calc-select, .calc-input { width: 100%; padding: 13px 16px; background: rgba(0,0,0,0.6); color: #FFF; border: 1px solid rgba(255,255,255,0.06); border-radius: 10px; font-size: 14px; font-family: 'Inter', sans-serif; outline: none; transition: border-color 0.3s; }
.calc-select:focus, .calc-input:focus { border-color: var(--cyan); }
.calc-slider { width: 100%; -webkit-appearance: none; height: 3px; background: rgba(255,255,255,0.06); border-radius: 2px; outline: none; }
.calc-slider::-webkit-slider-thumb { -webkit-appearance: none; width: 16px; height: 16px; border-radius: 50%; background: var(--cyan); cursor: pointer; box-shadow: 0 0 8px rgba(0,242,254,0.3); }
.calc-slider::-moz-range-thumb { width: 16px; height: 16px; border-radius: 50%; background: var(--cyan); cursor: pointer; border: none; box-shadow: 0 0 8px rgba(0,242,254,0.3); }
.calc-result { background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.04); border-radius: 12px; padding: 22px; }
.calc-result-row { display: flex; justify-content: space-between; padding: 8px 0; font-size: 13px; }
.calc-result-row span:first-child { color: var(--slate); }
.calc-result-row span:last-child { font-family: 'Space Grotesk', sans-serif; font-weight: 600; }
.calc-result-total { border-top: 1px solid rgba(255,255,255,0.06); margin-top: 8px; padding-top: 16px; }
.calc-result-total span:last-child { color: var(--emerald); font-size: 18px; }

/* Discord */
.discord-cta { text-align: center; padding: 64px 40px; border-radius: 20px; position: relative; overflow: hidden; }
.discord-cta::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, var(--cyan), transparent); }
.discord-cta h2 { font-family: 'Space Grotesk', sans-serif; font-size: clamp(26px, 4vw, 42px); font-weight: 700; margin-bottom: 14px; color: #FFF; letter-spacing: -0.5px; }
.discord-cta p { font-size: 15px; color: var(--slate); margin: 0 auto 28px; max-width: 460px; font-weight: 300; }
.discord-btn { display: inline-flex; align-items: center; gap: 10px; padding: 15px 36px; background: #FFF; color: #000; border: none; border-radius: 100px; font-size: 15px; font-weight: 700; cursor: pointer; transition: all 0.3s; }
.discord-btn:hover { transform: scale(1.05); background: var(--cyan); }

/* FAQ */
.faq-item { border-radius: 12px; margin-bottom: 10px; overflow: hidden; }
.faq-q { padding: 20px 24px; font-size: 15px; font-weight: 500; cursor: pointer; display: flex; justify-content: space-between; align-items: center; transition: color 0.3s; color: #FFF; }
.faq-q:hover { color: var(--cyan); }
.faq-q .arrow { transition: transform 0.3s; font-size: 12px; color: var(--slate-faint); }
.faq-q.open .arrow { transform: rotate(180deg); }
.faq-a { max-height: 0; overflow: hidden; transition: max-height 0.4s ease; }
.faq-a-inner { padding: 0 24px 20px; font-size: 14px; color: var(--slate); line-height: 1.7; font-weight: 300; }

/* Footer */
.footer { padding: 48px 40px; text-align: center; border-top: 1px solid rgba(255,255,255,0.04); margin-top: 60px; }
.footer-brand { display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 10px; }
.footer-logo { width: 28px; height: 28px; border-radius: 5px; }
.footer-text { font-family: 'JetBrains Mono', monospace; font-size: 16px; font-weight: 700; color: #FFF; letter-spacing: 4px; }
.footer-tag { font-size: 13px; color: var(--slate-faint); margin-bottom: 12px; font-weight: 300; }
.footer-disclaimer { max-width: 660px; margin: 8px auto 0; font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--slate-faint); line-height: 1.6; font-weight: 400; }

/* Reveal */
.reveal { opacity: 0; transform: translateY(30px); transition: all 0.7s cubic-bezier(0.23,1,0.32,1); }
.reveal.visible { opacity: 1; transform: translateY(0); }

/* Mobile */
@media (max-width: 768px) {
  .nav { padding: 16px; } .nav-links { display: none; } .nav-prelaunch { display: none; }
  .hero-content { padding: 80px 16px 20px; }
  .rex-section { grid-template-columns: 1fr; }
  .lb-header, .lb-row { grid-template-columns: 36px 1fr 70px; font-size: 12px; padding: 12px 14px; }
  .lb-header span:nth-child(3), .lb-header span:nth-child(4), .lb-row .lb-bracket, .lb-row .lb-rex { display: none; }
  .section { padding: 80px 20px; }
  .hero-strip-inner { flex-direction: column; gap: 10px; }
  .waitlist-input-wrap { flex-direction: column; padding: 12px; border-radius: 16px; }
  .waitlist-btn { width: 100%; padding: 12px; }
}
</style>
</head>
<body>

<canvas id="three-canvas"></canvas>

<nav class="nav">
  <div class="nav-brand">
    <img src="https://media.base44.com/images/public/6a73016f9b626430a0d26f88/033deb0ff_generated_image.png" alt="FORTREX" class="nav-logo">
    <span class="nav-text">FORTREX</span>
    <span class="nav-prelaunch">Pre-Launch</span>
  </div>
  <div class="nav-links">
    <a href="#arenas">Live Arenas</a>
    <a href="#rebates">Volume Rebates</a>
    <a href="#how">How It Works</a>
    <a href="#leaderboard">Rankings</a>
    <a href="#faq">FAQ</a>
  </div>
  <div class="nav-actions">
    <a href="#signin" class="nav-signin">Sign in</a>
    <button class="nav-cta">Get Started</button>
  </div>
</nav>

<div class="content">

<!-- HERO -->
<section class="hero">
  <div class="hero-video">
    <video autoplay loop muted playsinline>
      <source src="https://assets.mixkit.co/videos/preview/mixkit-abstract-technology-lines-in-motion-31780-large.mp4" type="video/mp4">
    </video>
    <div class="hero-overlay-v"></div>
    <div class="hero-overlay-h"></div>
    <div class="hero-glow"></div>
  </div>

  <div class="hero-content">
    <div class="hero-pill">
      <span class="dot"></span>
      <span>Founder Passes Active • Limited Access</span>
    </div>

    <h1>Your Edge.<br><span class="gradient-text">Your Arena.</span><br>Your Legacy.</h1>

    <p class="hero-sub">Deposit $100. Trade your strategy. Win cash prizes, earn free funded accounts, and get paid a $3/lot rebate on every order. Welcome to the Citadel.</p>

    <button class="btn-pill-primary">Enter FORTREX Citadel</button>

    <div class="waitlist">
      <div class="waitlist-input-wrap" id="waitlist-wrap">
        <input type="email" class="waitlist-input" id="waitlist-email" placeholder="your@email.com">
        <button class="waitlist-btn" id="waitlist-btn">Claim Access</button>
      </div>

      <div class="scarcity">
        <div class="scarcity-header">
          <span class="scarcity-label">Founder Slots Filled</span>
          <span class="scarcity-value" id="slots-text">0 / 1,000</span>
        </div>
        <div class="scarcity-bar">
          <div class="scarcity-fill" id="scarcity-fill" style="width: 0%"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="hero-strip">
    <div class="hero-strip-inner">
      <div class="hero-strip-item"><span class="check">✓</span> Verified Traders Only</div>
      <div class="hero-strip-item"><span class="check">✓</span> $3/Lot Automated Rebate</div>
      <div class="hero-strip-item"><span class="check">✓</span> Free Funded Accounts</div>
    </div>
  </div>
</section>

<!-- ARENAS -->
<section class="section" id="arenas">
  <span class="section-tag reveal">Live Competitions</span>
  <h2 class="section-title reveal">Live Arenas</h2>
  <p class="section-sub reveal">Verified traders. Real accounts. Skill-based competition. Every two weeks, a new arena opens.</p>
  <div class="arena-grid">
    <div class="arena-card glass glass-hover reveal">
      <div class="arena-status live"><span class="dot"></span> Live Now</div>
      <h3 class="arena-name">Opening Arena — Season 1</h3>
      <p class="arena-desc">First ever FORTREX tournament. All verified traders compete across 3 weight brackets. Composite scoring: ROI, consistency, risk management.</p>
      <div class="arena-prize"><span class="arena-prize-label">Prize Pool</span><span class="arena-prize-value">$15,000 + Funded</span></div>
      <div class="arena-progress">
        <div class="progress-bar"><div class="progress-fill" style="width: 73%"></div></div>
        <div class="progress-label"><span>1,460 / 2,000 entries</span><span>73%</span></div>
      </div>
    </div>
    <div class="arena-card glass glass-hover reveal">
      <div class="arena-status soon"><span class="dot"></span> Starting Soon</div>
      <h3 class="arena-name">Funded Account Arena</h3>
      <p class="arena-desc">Buy a funded account with our partner code. Compete for free funded accounts. Prop firm evaluation-based scoring.</p>
      <div class="arena-prize"><span class="arena-prize-label">Prize</span><span class="arena-prize-value">5× $100K Accounts</span></div>
      <div class="arena-progress">
        <div class="progress-bar"><div class="progress-fill" style="width: 41%"></div></div>
        <div class="progress-label"><span>820 / 2,000 entries</span><span>41%</span></div>
      </div>
    </div>
    <div class="arena-card glass glass-hover reveal">
      <div class="arena-status locked"><span class="dot"></span> Locked</div>
      <h3 class="arena-name">Mega Arena — Season Finale</h3>
      <p class="arena-desc">The biggest arena of Season 1. Unlock requires 5,000 verified traders. Massive prize pool. Season champions crowned.</p>
      <div class="arena-prize"><span class="arena-prize-label">Prize Pool</span><span class="arena-prize-value">$50,000+ TBA</span></div>
      <div class="arena-progress">
        <div class="progress-bar"><div class="progress-fill" style="width: 28%"></div></div>
        <div class="progress-label"><span>Unlocks at 5,000 verified</span><span>1,400 / 5,000</span></div>
      </div>
    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section class="section" id="how">
  <span class="section-tag reveal">Getting Started</span>
  <h2 class="section-title reveal">Three Steps to the Arena</h2>
  <p class="section-sub reveal">No complexity. No confusion. Register, verify, compete.</p>
  <div class="steps">
    <div class="step glass glass-hover reveal">
      <div class="step-num">01</div>
      <h3>Open & Verify</h3>
      <p>Open a broker account with our partner link. Deposit $100. Complete verification. You're now an official FORTREX trader.</p>
    </div>
    <div class="step glass glass-hover reveal">
      <div class="step-num">02</div>
      <h3>Enter & Compete</h3>
      <p>Join active tournaments. Trade your strategy. Your performance is scored on ROI, consistency, and risk management. Skill decides the winner.</p>
    </div>
    <div class="step glass glass-hover reveal">
      <div class="step-num">03</div>
      <h3>Win & Earn</h3>
      <p>Cash rewards. Free funded accounts. Plus $3 back on every lot you trade. The more you trade, the more you earn.</p>
    </div>
  </div>
</section>

<!-- REBATES -->
<section class="section" id="rebates">
  <span class="section-tag reveal">Automated Rebates</span>
  <h2 class="section-title reveal">$3 Per Lot. Every Trade.</h2>
  <p class="section-sub reveal">Every verified FORTREX trader earns $3 back for every lot they trade. Funded by our broker partnership — we share our affiliate commission with you. No cap. No catch.</p>
  <div class="rebate-grid">
    <div class="rebate-card glass glass-hover reveal">
      <div class="label">Per Lot Rebate</div>
      <div class="value cyan">$3</div>
      <div class="note">On every single order</div>
    </div>
    <div class="rebate-card glass glass-hover reveal">
      <div class="label">Monthly Cap</div>
      <div class="value">None</div>
      <div class="note">Trade more, earn more</div>
    </div>
    <div class="rebate-card glass glass-hover reveal">
      <div class="label">Payout</div>
      <div class="value">Auto</div>
      <div class="note">No manual claims</div>
    </div>
    <div class="rebate-card glass glass-hover reveal">
      <div class="label">Eligibility</div>
      <div class="value">$100+</div>
      <div class="note">Min deposit required</div>
    </div>
  </div>
</section>

<!-- REX -->
<section class="section" id="rex">
  <span class="section-tag reveal">FORTREX Currency</span>
  <h2 class="section-title reveal">Earn Your Rex</h2>
  <p class="section-sub reveal">Rex is the FORTREX loyalty reward. Earn it through engagement. Redeem it for value. No purchase necessary.</p>
  <div class="rex-section">
    <div class="reveal">
      <div class="rex-holo">
        <div class="rex-symbol gradient-text">R</div>
        <div class="rex-label">Rex — Loyalty Reward</div>
        <div class="rex-balance">12,450</div>
        <div class="rex-balance-label">YOUR BALANCE</div>
        <div class="rex-note">Rex is a closed-loop loyalty reward point. Not a cryptocurrency. Not transferable. Not redeemable for cash.</div>
      </div>
    </div>
    <div>
      <div class="rex-earn reveal">
        <h4>Earn Rex</h4>
        <ul class="rex-list">
          <li><span>Daily login streak (Day 1-30)</span><span>10-300 Rex</span></li>
          <li><span>Each verified referral</span><span>500 Rex</span></li>
          <li><span>Instagram post with #FORTREX</span><span>100 Rex</span></li>
          <li><span>Complete trading quizzes</span><span>50-200 Rex</span></li>
          <li><span>Tournament participation</span><span>100-1000 Rex</span></li>
        </ul>
      </div>
      <div class="rex-spend reveal">
        <h4>Redeem Rex</h4>
        <ul class="rex-list">
          <li><span>Lucky draw ticket (free entry)</span><span>200 Rex</span></li>
          <li><span>Tournament entry pass</span><span>500 Rex</span></li>
          <li><span>Premium Discord role (30 days)</span><span>1,000 Rex</span></li>
          <li><span>Free funded account entry</span><span>5,000 Rex</span></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- LEADERBOARD -->
<section class="section" id="leaderboard">
  <span class="section-tag reveal">Live Rankings</span>
  <h2 class="section-title reveal">The Leaderboard</h2>
  <p class="section-sub reveal">Real-time rankings. Updated as trades are verified. Skill determines position — not account size.</p>
  <div class="leaderboard glass reveal">
    <div class="lb-header"><span>Rank</span><span>Trader</span><span>Bracket</span><span>Score</span><span>Rex</span></div>
    <div class="lb-row"><div class="lb-rank gold">01</div><div class="lb-name">@alex_goldfx</div><div class="lb-bracket">Heavyweight</div><div class="lb-score">94.7</div><div class="lb-rex">12,450</div></div>
    <div class="lb-row"><div class="lb-rank silver">02</div><div class="lb-name">@sara_trades</div><div class="lb-bracket">Middleweight</div><div class="lb-score">91.2</div><div class="lb-rex">10,820</div></div>
    <div class="lb-row"><div class="lb-rank bronze">03</div><div class="lb-name">@nikhil_pips</div><div class="lb-bracket">Lightweight</div><div class="lb-score">88.9</div><div class="lb-rex">9,340</div></div>
    <div class="lb-row"><div class="lb-rank">04</div><div class="lb-name">@dubai_scalper</div><div class="lb-bracket">Heavyweight</div><div class="lb-score">85.3</div><div class="lb-rex">7,910</div></div>
    <div class="lb-row"><div class="lb-rank">05</div><div class="lb-name">@maya_fx</div><div class="lb-bracket">Middleweight</div><div class="lb-score">83.1</div><div class="lb-rex">6,450</div></div>
  </div>
</section>

<!-- CALCULATOR -->
<section class="section" id="calculator">
  <span class="section-tag reveal">Trader's Arsenal</span>
  <h2 class="section-title reveal">Lot Size Calculator</h2>
  <p class="section-sub reveal">Calculate your position size, risk, and rebate earnings. Real numbers, real fast.</p>
  <div class="calc-card glass reveal">
    <div class="calc-row"><label class="calc-label">ACCOUNT SIZE (USD)</label>
      <select class="calc-select" id="calc-account">
        <option value="100">$100</option><option value="500">$500</option>
        <option value="1000" selected>$1,000</option><option value="5000">$5,000</option>
        <option value="10000">$10,000</option><option value="50000">$50,000</option><option value="100000">$100,000</option>
      </select></div>
    <div class="calc-row"><label class="calc-label">RISK PER TRADE (%)</label>
      <input type="range" class="calc-slider" id="calc-risk" min="0.5" max="10" step="0.5" value="2">
      <span id="calc-risk-val" style="color: var(--cyan); font-weight: 600; font-size: 13px; font-family: 'JetBrains Mono', monospace;">2%</span></div>
    <div class="calc-row"><label class="calc-label">CURRENCY PAIR</label>
      <select class="calc-select" id="calc-pair">
        <option value="100000">EUR/USD</option><option value="100000">GBP/USD</option>
        <option value="150000">USD/JPY</option><option value="1300">XAU/USD (Gold)</option>
        <option value="1">BTC/USD</option><option value="1000">ETH/USD</option>
      </select></div>
    <div class="calc-row"><label class="calc-label">STOP LOSS (PIPS)</label>
      <input type="number" class="calc-input" id="calc-sl" value="20" min="1"></div>
    <div class="calc-result">
      <div class="calc-result-row"><span>Risk Amount</span><span id="result-risk">$20.00</span></div>
      <div class="calc-result-row"><span>Pip Value</span><span id="result-pip">$1.00/pip</span></div>
      <div class="calc-result-row"><span>Position Size</span><span id="result-lots">1.00 lots</span></div>
      <div class="calc-result-row calc-result-total"><span>Rex Rebate (per trade)</span><span id="result-rebate">$3.00</span></div>
    </div>
  </div>
</section>

<!-- DISCORD -->
<section class="section">
  <div class="discord-cta glass reveal">
    <h2>Join FORTREX Citadel</h2>
    <p>The real community lives on Discord. Tournament reveals, prize pool announcements, trader discussions — all in one place. Verified traders only.</p>
    <button class="discord-btn">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M19.27 5.33C17.94 4.71 16.5 4.26 15 4a.09.09 0 0 0-.07.03c-.18.33-.39.76-.53 1.09a16.35 16.35 0 0 0-4.8 0c-.14-.34-.35-.76-.54-1.09-.01-.02-.04-.03-.07-.03-1.5.26-2.93.71-4.27 1.33-.01 0-.02.01-.03.02-2.72 4.07-3.47 8.03-3.1 11.95 0 .02.01.04.03.05 1.8 1.32 3.53 2.12 5.24 2.65.03.01.06 0 .07-.02.4-.55.76-1.13 1.07-1.74.02-.04 0-.08-.04-.09-.57-.22-1.11-.48-1.64-.78-.04-.02-.04-.08-.01-.11.11-.08.22-.17.33-.25.02-.02.05-.02.07-.01 3.44 1.57 7.15 1.57 10.55 0 .02-.01.05-.01.07.01.11.09.22.17.33.26.04.03.04.09-.01.11-.52.31-1.07.56-1.64.78-.04.01-.05.06-.04.09.32.61.68 1.19 1.07 1.74.03.02.06.03.09.02 1.72-.53 3.45-1.33 5.25-2.65.02-.01.03-.03.03-.05.44-4.53-.73-8.46-3.1-11.95-.01-.01-.02-.02-.04-.02zM8.52 14.91c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12 0 1.17-.84 2.12-1.89 2.12zm6.97 0c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12 0 1.17-.83 2.12-1.89 2.12z"/></svg>
      Join FORTREX Citadel
    </button>
  </div>
</section>

<!-- FAQ -->
<section class="section" id="faq">
  <span class="section-tag reveal">Questions, Answered</span>
  <h2 class="section-title reveal">FAQ</h2>
  <div style="max-width: 760px;">
    <div class="faq-item glass reveal"><div class="faq-q">What is FORTREX? <span class="arrow">▼</span></div><div class="faq-a"><div class="faq-a-inner">FORTREX is a professional trading community that organizes skill-based competitions for verified traders. We partner with brokers and prop firms to offer real rewards — cash and funded accounts — to traders who demonstrate superior trading skill.</div></div></div>
    <div class="faq-item glass reveal"><div class="faq-q">How do I enter a competition? <span class="arrow">▼</span></div><div class="faq-a"><div class="faq-a-inner">Open a broker account using our partner link, deposit $100, and complete verification. Once verified, you can join any live arena. For prop firm arenas, purchase a funded account using our partner code.</div></div></div>
    <div class="faq-item glass reveal"><div class="faq-q">How are winners decided? <span class="arrow">▼</span></div><div class="faq-a"><div class="faq-a-inner">Winners are determined by a composite score: 40% ROI (percentage-based, not raw profit), 30% consistency (daily returns, win rate, profit factor), and 30% risk management (drawdown adherence, lot size discipline). This ensures fair competition across different account sizes.</div></div></div>
    <div class="faq-item glass reveal"><div class="faq-q">What is the $3/lot rebate? <span class="arrow">▼</span></div><div class="faq-a"><div class="faq-a-inner">Every verified FORTREX trader earns $3 back for every lot they trade. This is funded by our broker partnership — we share our affiliate commission with you. Trade more, earn more. No cap. No catch.</div></div></div>
    <div class="faq-item glass reveal"><div class="faq-q">What is Rex? <span class="arrow">▼</span></div><div class="faq-a"><div class="faq-a-inner">Rex is FORTREX's loyalty reward point system. Earn Rex through daily logins, referrals, quizzes, and tournament participation. Redeem Rex for lucky draw tickets, tournament passes, and more. Rex is not a cryptocurrency and cannot be converted to cash.</div></div></div>
    <div class="faq-item glass reveal"><div class="faq-q">Is this gambling? <span class="arrow">▼</span></div><div class="faq-a"><div class="faq-a-inner">No. FORTREX competitions are skill-based — winners are determined by trading performance metrics (ROI, consistency, risk management), not by chance. Users are responsible for complying with their local jurisdiction's laws.</div></div></div>
    <div class="faq-item glass reveal"><div class="faq-q">How often do tournaments run? <span class="arrow">▼</span></div><div class="faq-a"><div class="faq-a-inner">Tournaments run every two weeks — two per month. Each tournament has its own prize pool, brackets, and rules. Season finales bring the biggest rewards.</div></div></div>
    <div class="faq-item glass reveal"><div class="faq-q">Why do I need to join Discord? <span class="arrow">▼</span></div><div class="faq-a"><div class="faq-a-inner">FORTREX Citadel on Discord is our community hub. Tournament prize pool reveals, live announcements, trader discussions, and support all happen there. Your FORTREX identity and Rex balance sync across both platforms.</div></div></div>
  </div>
</section>

<footer class="footer">
  <div class="footer-brand">
    <img src="https://media.base44.com/images/public/6a73016f9b626430a0d26f88/033deb0ff_generated_image.png" alt="FORTREX" class="footer-logo">
    <span class="footer-text">FORTREX</span>
  </div>
  <p class="footer-tag">Your Edge. Your Arena. Your Legacy.</p>
  <p class="footer-disclaimer">FORTREX is a professional trading community and competition platform. We do not provide broker services, investment advice, or financial recommendations. Users are responsible for complying with their local jurisdiction's laws. All competitions are skill-based. Rex is a closed-loop loyalty reward point, not a cryptocurrency or financial instrument.</p>
</footer>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
// ===== THREE.JS — background for scroll sections =====
const canvas = document.getElementById('three-canvas');
const scene = new THREE.Scene();
scene.fog = new THREE.FogExp2(0x000000, 0.018);

const camera = new THREE.PerspectiveCamera(50, window.innerWidth / window.innerHeight, 0.1, 100);
camera.position.set(0, 8, 22);

const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.setClearColor(0x000000, 1);

scene.add(new THREE.AmbientLight(0x0F1525, 0.35));

const cyanKey = new THREE.SpotLight(0x00F2FE, 2, 70, Math.PI / 4, 0.5, 1);
cyanKey.position.set(8, 20, 12); cyanKey.target.position.set(0, 2, 0);
scene.add(cyanKey); scene.add(cyanKey.target);

const indigoFill = new THREE.PointLight(0x6366F1, 0.7, 35);
indigoFill.position.set(-10, 4, 8); scene.add(indigoFill);

const emeraldAccent = new THREE.PointLight(0x10B981, 0.5, 25);
emeraldAccent.position.set(6, -2, -6); scene.add(emeraldAccent);

const dirLight = new THREE.DirectionalLight(0x4A5568, 0.25);
dirLight.position.set(-5, 10, -12); scene.add(dirLight);

const fortMat = new THREE.MeshStandardMaterial({ color: 0x0A0D14, metalness: 0.9, roughness: 0.3, flatShading: true });
const fortMatDark = new THREE.MeshStandardMaterial({ color: 0x070910, metalness: 0.95, roughness: 0.35, flatShading: true });
const edgeMat = new THREE.LineBasicMaterial({ color: 0x00F2FE, transparent: true, opacity: 0.25 });
const accentMat = new THREE.MeshStandardMaterial({ color: 0x00F2FE, metalness: 1, roughness: 0.1, emissive: 0x00F2FE, emissiveIntensity: 0.2 });

function addEdges(mesh, mat = edgeMat) {
  const edges = new THREE.EdgesGeometry(mesh.geometry);
  mesh.add(new THREE.LineSegments(edges, mat));
}

const fortress = new THREE.Group();
const base = new THREE.Mesh(new THREE.CylinderGeometry(9, 10, 1.5, 8), fortMatDark);
base.position.y = -0.75; addEdges(base); fortress.add(base);

const keep = new THREE.Mesh(new THREE.BoxGeometry(3.5, 7, 3.5), fortMat);
keep.position.y = 4; addEdges(keep); fortress.add(keep);

for (let i = 0; i < 10; i++) {
  if (i % 2 !== 0) continue;
  const angle = (i / 10) * Math.PI * 2;
  const b = new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.7, 0.5), fortMat);
  b.position.set(Math.cos(angle) * 2.1, 7.85, Math.sin(angle) * 2.1);
  addEdges(b); fortress.add(b);
}

const door = new THREE.Mesh(new THREE.BoxGeometry(1.2, 2, 0.3),
  new THREE.MeshStandardMaterial({ color: 0x0A1A18, metalness: 0.7, roughness: 0.4, emissive: 0x00F2FE, emissiveIntensity: 0.06 }));
door.position.set(0, 1.5, 1.8); fortress.add(door);

[{x:-5,z:-1},{x:5,z:-1},{x:-4,z:4},{x:4,z:4}].forEach((pos, i) => {
  const h = 4.5 + (i % 2) * 1.2;
  const t = new THREE.Mesh(new THREE.CylinderGeometry(1.2, 1.5, h, 6), fortMat);
  t.position.set(pos.x, h/2, pos.z); addEdges(t); fortress.add(t);
  const r = new THREE.Mesh(new THREE.ConeGeometry(1.4, 1.5, 6), fortMatDark);
  r.position.set(pos.x, h + 0.75, pos.z); addEdges(r); fortress.add(r);
  const tip = new THREE.Mesh(new THREE.SphereGeometry(0.12, 6, 6), accentMat);
  tip.position.set(pos.x, h + 1.6, pos.z); fortress.add(tip);
});

[{x:-3.2,z:1.5,w:3,h:3.5,d:0.4,rot:0.3},{x:3.2,z:1.5,w:3,h:3.5,d:0.4,rot:-0.3},
 {x:-2.5,z:3.5,w:4,h:3,d:0.4,rot:0.6},{x:2.5,z:3.5,w:4,h:3,d:0.4,rot:-0.6}].forEach(wc => {
  const w = new THREE.Mesh(new THREE.BoxGeometry(wc.w, wc.h, wc.d), fortMat);
  w.position.set(wc.x, wc.h/2, wc.z); w.rotation.y = wc.rot; addEdges(w); fortress.add(w);
  for (let j = 0; j < 5; j++) {
    const wb = new THREE.Mesh(new THREE.BoxGeometry(0.3, 0.4, 0.45), fortMat);
    const lx = -wc.w/2 + 0.5 + j * (wc.w - 1) / 4;
    wb.position.set(wc.x + Math.cos(wc.rot) * lx, wc.h + 0.2, wc.z + Math.sin(wc.rot) * lx);
    wb.rotation.y = wc.rot; addEdges(wb); fortress.add(wb);
  }
});

const flagPole = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.06, 2.5, 4), accentMat);
flagPole.position.set(0, 9, 0); fortress.add(flagPole);
const flag = new THREE.Mesh(new THREE.PlaneGeometry(1.3, 0.9),
  new THREE.MeshStandardMaterial({ color: 0x00F2FE, metalness: 0.8, roughness: 0.15, side: THREE.DoubleSide, emissive: 0x00F2FE, emissiveIntensity: 0.1 }));
flag.position.set(0.65, 9.5, 0); fortress.add(flag);

[-0.8, 0.8].forEach(tx => {
  const torch = new THREE.Mesh(new THREE.SphereGeometry(0.12, 6, 6),
    new THREE.MeshStandardMaterial({ color: 0x00F2FE, emissive: 0x00F2FE, emissiveIntensity: 2 }));
  torch.position.set(tx, 2.5, 1.9); fortress.add(torch);
  const tl = new THREE.PointLight(0x00F2FE, 0.35, 5);
  tl.position.set(tx, 2.5, 2); fortress.add(tl);
});

scene.add(fortress);

const candlesticks = [];
for (let i = 0; i < 28; i++) {
  const angle = (i / 28) * Math.PI * 2 + Math.random() * 0.3;
  const radius = 13 + Math.random() * 5;
  const isBull = Math.random() > 0.45;
  const bh = 0.5 + Math.random() * 3;
  const wh = bh + 1 + Math.random() * 2;
  const bw = 0.35 + Math.random() * 0.25;
  const body = new THREE.Mesh(new THREE.BoxGeometry(bw, bh, bw),
    new THREE.MeshStandardMaterial({ color: isBull ? 0x10B981 : 0xEF4444, metalness: 0.5, roughness: 0.3,
      emissive: isBull ? 0x10B981 : 0xEF4444, emissiveIntensity: 0.06, transparent: true, opacity: 0.35 }));
  body.position.set(Math.cos(angle) * radius, bh / 2, Math.sin(angle) * radius);
  addEdges(body, new THREE.LineBasicMaterial({ color: isBull ? 0x10B981 : 0xEF4444, transparent: true, opacity: 0.15 }));
  scene.add(body);
  const wick = new THREE.Mesh(new THREE.CylinderGeometry(0.03, 0.03, wh, 4),
    new THREE.MeshBasicMaterial({ color: isBull ? 0x10B981 : 0xEF4444, transparent: true, opacity: 0.15 }));
  wick.position.set(Math.cos(angle) * radius, wh / 2, Math.sin(angle) * radius);
  scene.add(wick);
  candlesticks.push({ body, wick, baseY: bh / 2, phase: Math.random() * Math.PI * 2 });
}

const pCount = 350;
const pGeo = new THREE.BufferGeometry();
const pPos = new Float32Array(pCount * 3);
const pCol = new Float32Array(pCount * 3);
const pVel = new Float32Array(pCount);
for (let i = 0; i < pCount; i++) {
  pPos[i*3] = (Math.random() - 0.5) * 40; pPos[i*3+1] = Math.random() * 20; pPos[i*3+2] = (Math.random() - 0.5) * 40;
  const t = Math.random() > 0.3; pCol[i*3] = t ? 0 : 0.51; pCol[i*3+1] = t ? 0.95 : 0.56; pCol[i*3+2] = t ? 1 : 0.97;
  pVel[i] = 0.004 + Math.random() * 0.01;
}
pGeo.setAttribute('position', new THREE.BufferAttribute(pPos, 3));
pGeo.setAttribute('color', new THREE.BufferAttribute(pCol, 3));
const particles = new THREE.Points(pGeo, new THREE.PointsMaterial({ size: 0.04, vertexColors: true, transparent: true, opacity: 0.25, blending: THREE.AdditiveBlending, depthWrite: false }));
scene.add(particles);

const floor = new THREE.Mesh(new THREE.PlaneGeometry(80, 80),
  new THREE.MeshStandardMaterial({ color: 0x000000, metalness: 0.95, roughness: 0.25, transparent: true, opacity: 0.35 }));
floor.rotation.x = -Math.PI / 2; floor.position.y = -1.5; scene.add(floor);

// Camera
let mouseX = 0, mouseY = 0, targetX = 0, targetY = 0, scrollY = 0;
window.addEventListener('mousemove', e => { mouseX = (e.clientX / window.innerWidth - 0.5) * 2; mouseY = (e.clientY / window.innerHeight - 0.5) * 2; });
window.addEventListener('scroll', () => { scrollY = window.scrollY; });
window.addEventListener('resize', () => { camera.aspect = window.innerWidth / window.innerHeight; camera.updateProjectionMatrix(); renderer.setSize(window.innerWidth, window.innerHeight); renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2)); });

function lerp(a, b, t) { return a + (b - a) * t; }

const camKeyframes = [
  { x: 0, y: 8, z: 22, lookY: 4 }, { x: -6, y: 5, z: 18, lookY: 3 },
  { x: 8, y: 7, z: 16, lookY: 3 }, { x: -4, y: 3, z: 14, lookY: 4 },
  { x: 5, y: 12, z: 18, lookY: 2 }, { x: -8, y: 4, z: 15, lookY: 3 },
  { x: 0, y: 10, z: 20, lookY: 3 }, { x: 3, y: 8, z: 22, lookY: 3 },
];

function getCamTarget() {
  const sh = window.innerHeight;
  const si = Math.min(Math.floor(scrollY / sh), camKeyframes.length - 1);
  const ni = Math.min(si + 1, camKeyframes.length - 1);
  const sp = (scrollY / sh) - si;
  const eased = sp < 0.5 ? 2 * sp * sp : 1 - Math.pow(-2 * sp + 2, 2) / 2;
  const c = camKeyframes[si], n = camKeyframes[ni];
  return { x: lerp(c.x, n.x, eased), y: lerp(c.y, n.y, eased), z: lerp(c.z, n.z, eased), lookY: lerp(c.lookY, n.lookY, eased) };
}

const clock = new THREE.Clock();
let camPos = { x: 0, y: 8, z: 22, lookY: 4 };

function animate() {
  requestAnimationFrame(animate);
  const t = clock.getElapsedTime();
  targetX += (mouseX - targetX) * 0.04; targetY += (mouseY - targetY) * 0.04;
  const tgt = getCamTarget();
  camPos.x = lerp(camPos.x, tgt.x + targetX * 1.5, 0.04);
  camPos.y = lerp(camPos.y, tgt.y - targetY * 1, 0.04);
  camPos.z = lerp(camPos.z, tgt.z, 0.04);
  camPos.lookY = lerp(camPos.lookY, tgt.lookY, 0.04);
  camera.position.set(camPos.x, camPos.y + Math.sin(t * 0.5) * 0.12, camPos.z);
  camera.lookAt(0, camPos.lookY, 0);
  fortress.rotation.y = t * 0.04;
  flag.rotation.z = Math.sin(t * 2) * 0.08; flag.rotation.x = Math.cos(t * 1.5) * 0.04;
  candlesticks.forEach(c => {
    const p = 1 + Math.sin(t * 1.5 + c.phase) * 0.1;
    c.body.scale.y = p; c.body.position.y = c.baseY * p;
    c.wick.scale.y = p; c.wick.position.y = c.baseY * p;
    c.body.material.emissiveIntensity = 0.04 + Math.sin(t * 2 + c.phase) * 0.05;
  });
  const pa = particles.geometry.attributes.position;
  for (let i = 0; i < pCount; i++) { pa.array[i*3+1] += pVel[i]; if (pa.array[i*3+1] > 20) pa.array[i*3+1] = -2; pa.array[i*3] += Math.sin(t * 0.5 + i) * 0.003; }
  pa.needsUpdate = true; particles.rotation.y = t * 0.008;
  cyanKey.position.x = Math.sin(t * 0.15) * 10; cyanKey.position.z = Math.cos(t * 0.15) * 10 + 5;
  
  // Show 3D canvas only after scrolling past hero
  const heroHeight = window.innerHeight;
  const showCanvas = scrollY > heroHeight * 0.7;
  canvas.style.opacity = showCanvas ? '0.5' : '0';
  
  renderer.render(scene, camera);
}
animate();

// Waitlist
const waitlistBtn = document.getElementById('waitlist-btn');
const waitlistEmail = document.getElementById('waitlist-email');
const waitlistWrap = document.getElementById('waitlist-wrap');
waitlistBtn.addEventListener('click', () => {
  if (waitlistEmail.value) {
    waitlistWrap.innerHTML = '<div class="waitlist-claimed"><span>✓ You\'re on the list. Check your inbox.</span></div>';
  }
});

// Scarcity counter
const slotsTarget = 718, totalSlots = 1000;
const slotsText = document.getElementById('slots-text');
const scarcityFill = document.getElementById('scarcity-fill');
let currentSlots = 0;
const slotInterval = setInterval(() => {
  currentSlots += Math.ceil((slotsTarget - currentSlots) / 10);
  if (currentSlots >= slotsTarget) { currentSlots = slotsTarget; clearInterval(slotInterval); }
  slotsText.textContent = currentSlots.toLocaleString() + ' / 1,000';
  scarcityFill.style.width = (currentSlots / totalSlots * 100) + '%';
}, 60);

// FAQ
document.querySelectorAll('.faq-q').forEach(q => {
  q.addEventListener('click', () => {
    const a = q.nextElementSibling;
    const open = a.style.maxHeight && a.style.maxHeight !== '0px';
    document.querySelectorAll('.faq-a').forEach(i => i.style.maxHeight = '0px');
    document.querySelectorAll('.faq-q').forEach(i => i.classList.remove('open'));
    if (!open) { a.style.maxHeight = a.scrollHeight + 'px'; q.classList.add('open'); }
  });
});

// Calculator
function calcLot() {
  const account = parseFloat(document.getElementById('calc-account').value);
  const riskPct = parseFloat(document.getElementById('calc-risk').value);
  const pair = parseFloat(document.getElementById('calc-pair').value);
  const sl = parseFloat(document.getElementById('calc-sl').value) || 20;
  document.getElementById('calc-risk-val').textContent = riskPct + '%';
  const riskAmount = account * (riskPct / 100);
  const pipValue = pair / 100000;
  const lots = riskAmount / (sl * pipValue);
  const rebate = lots * 3;
  document.getElementById('result-risk').textContent = '$' + riskAmount.toFixed(2);
  document.getElementById('result-pip').textContent = '$' + pipValue.toFixed(2) + '/pip';
  document.getElementById('result-lots').textContent = lots.toFixed(2) + ' lots';
  document.getElementById('result-rebate').textContent = '$' + rebate.toFixed(2);
}
['calc-account', 'calc-pair'].forEach(id => document.getElementById(id).addEventListener('change', calcLot));
['calc-risk', 'calc-sl'].forEach(id => document.getElementById(id).addEventListener('input', calcLot));
calcLot();

// Reveal
const obs = new IntersectionObserver(entries => { entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }); }, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));
</script>
</body>
</html>
