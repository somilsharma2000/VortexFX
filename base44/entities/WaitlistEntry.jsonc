{
  "name": "WaitlistEntry",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "position": {
      "type": "number"
    },
    "referred_by": {
      "type": "string"
    },
    "discord_joined": {
      "type": "boolean"
    },
    "telegram_joined": {
      "type": "boolean"
    },
    "signup_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "default": "pending"
    },
    "source": {
      "type": "string"
    },
    "joinedDate": {
      "type": "string"
    }
  },
  "required": [
    "email"
  ]
}