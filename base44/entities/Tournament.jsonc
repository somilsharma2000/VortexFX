      "type": "string"
    },
    "is_active": {
      "type": "boolean"
    },
    "markets": {
      "type": "string"
    },
    "maxParticipants": {
      "type": "number"
    },
    "name": {
      "type": "string"
    },
    "participant_count": {
      "type": "number"
    },
    "prize_pool_rex": {
      "type": "number"
    },
