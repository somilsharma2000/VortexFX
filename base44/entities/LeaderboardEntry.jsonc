{
  "name": "LeaderboardEntry",
  "type": "object",
  "properties": {
    "tournament_id": {
      "type": "string"
    },
    "tournament_name": {
      "type": "string"
    },
    "trader_name": {
      "type": "string"
    },
    "rank": {
      "type": "number"
    },
    "roi": {
      "type": "number"
    },
    "final_equity": {
      "type": "number"
    },
    "trades": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "sealed",
        "revealed"
      ],
      "default": "sealed"
    },
    "mt4_verified": {
      "type": "boolean",
      "default": false
    },
    "revealed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "tournament_id",
    "trader_name"
  ]
}